{
  "name": "@your-scope/chain-of-responsibility-ts",
  "version": "1.0.0",
  "description": "A lightweight, type-safe implementation of the Chain of Responsibility pattern in TypeScript",
  "license": "MIT",
  "repository": {
    "type": "github",
    "url": "https://github.com/yourusername/chain-of-responsibility-ts"
  },
  "keywords": [
    "chain-of-responsibility",
    "design-pattern",
    "typescript",
    "middleware",
    "pipeline",
    "async"
  ],
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "dev": "deno run --watch main.ts",
    "test": "deno test",
    "check": "deno check mod.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/async/delay": "jsr:@std/async/delay",
    "@/": "./src/"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true
  },
  "exclude": [
    "main.ts",
    "examples/",
    "dist/"
  ]
}
